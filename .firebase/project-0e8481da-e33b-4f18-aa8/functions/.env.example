# Environment
NODE_ENV=development

# Database
DATABASE_URL="postgresql://carbonlens:carbonlens_dev@localhost:5432/carbonlens?schema=public"

# Authentication
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-secure-random-string-min-32-chars"

# Redis (optional for development — falls back to in-memory cache)
REDIS_URL="redis://localhost:6379"

# Application
NEXT_PUBLIC_APP_NAME="CarbonLens"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Feature Flags
NEXT_PUBLIC_ENABLE_LIVING_WORLD=true
